# Copy this file to ".env" and fill in your values.
# (.env is private — never share it or commit it to git.)

# Name shown in the top-left of the app
EVENT_NAME=Open Data x AI

# ---- Network ----
# Port for the web page: http://localhost:3000
PORT=3000

# Who can open the app:
#   127.0.0.1  = only this laptop (safest, default)
#   0.0.0.0    = other devices on the same Wi-Fi too (then also set ALLOWED_HOSTS)
#                There is no login, so anyone on that Wi-Fi could open the app.
HOST=127.0.0.1

# Extra addresses the app answers to, comma separated, e.g. this laptop's Wi-Fi IP:
# ALLOWED_HOSTS=192.168.1.20

# HTTPS (recommended when HOST=0.0.0.0). See SECURITY.md for how to make these files.
# TLS_CERT_FILE=certs/cert.pem
# TLS_KEY_FILE=certs/key.pem

# ---- Gmail (only needed for "Send QR Codes") ----
# The Gmail address the emails are sent from
GMAIL_USER=yourname@gmail.com

# A 16-character Gmail *App Password* (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords — see README.md.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Name shown as the sender in people's inbox (optional)
FROM_NAME=Open Data x AI Team

# Pause between emails in milliseconds (optional, default 1500)
# SEND_DELAY_MS=1500

# Scanning the same person again within this many seconds is not counted twice.
# After that, every scan is a new check-in (people can check in many times, on many days).
CHECKIN_COOLDOWN_SECONDS=60
